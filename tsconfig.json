{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "apps/web/src",
    "apps/host/src",
    "apps/worker/src",
    "packages",
    "tests/unit",
    "tests/contract",
    "tests/browser/fixtures",
    "tests/opt-in/*.ts"
  ]
}
